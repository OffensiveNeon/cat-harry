diff --git a/pc_port/include/pc_costume.h b/pc_port/include/pc_costume.h
new file mode 100644
index 0000000..a29283b
--- /dev/null
+++ b/pc_port/include/pc_costume.h
@@ -0,0 +1,47 @@
+#ifndef PC_COSTUME_H
+#define PC_COSTUME_H
+
+/* Optional costume pieces (mods/halloween.shc): small meshes attached to a
+ * character's bones — rigid (hats, ears) or spring-physics chains (tails).
+ *
+ * The pack is built outside this repo (cat_harry_pack.py in the cat-harry
+ * repo); its layout is documented there. No pack = nothing changes. Pieces are
+ * lit by the game's own lights and drawn with one swatch texture in a hires
+ * pool slot; a piece can also hide some of its character's own parts. */
+
+#include "game.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Bracket a character's skeleton draw (world_draw.c) so the bone draw below
+ * knows whose pieces to add. */
+void Pc_Costume_BeginChara(s32 charaId);
+void Pc_Costume_EndChara(void);
+
+/* True when the current character has costume pieces (loads the pack on first use). */
+int Pc_Costume_Active(void);
+
+/* True when the current character's bone boneIdx is hidden under a piece. */
+int Pc_Costume_HideBone(s32 boneIdx);
+
+/* A private OT that is never drawn: hidden bones transform into it so the
+ * bones welded to them still read their own vertices. */
+GsOT* Pc_Costume_ScratchOt(void);
+
+/* Draw the current character's pieces into otTag (the bucket of the stock parts);
+ * firstPerson hides pieces flagged for it (Harry's ears). */
+void Pc_Costume_Draw(GsCOORDINATE2* boneCoords, GsOT_TAG* otTag, s32 arg2, u16 arg5, int firstPerson);
+
+/* Once per gameplay frame: draw the pack's world props placed in this map.
+ * Built with COSTUME_MARKS it also watches for the mark-spot combo (hold
+ * L1+R1+L2+R2), which logs Harry's map and floor position and drops a
+ * jack-o'-lantern there for this session. */
+void Pc_Costume_DrawProps(GsOT* ot, s32 arg2);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PC_COSTUME_H */
