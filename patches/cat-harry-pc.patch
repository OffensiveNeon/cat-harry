+    unsigned char noClamp; /* report no hires dims: the shader's per-native-texel clamp stays off */
 } PoolSlotEntry;
 
 static PoolSlotEntry g_poolSlots[HIRES_POOL_SLOT_MAX];
 
+void HiresOverride_PoolSlotSetNoClamp(int slotId, int on)
