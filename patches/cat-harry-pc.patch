diff --git a/pc_port/src/pc_costume.c b/pc_port/src/pc_costume.c
new file mode 100644
index 0000000..3af123b
--- /dev/null
+++ b/pc_port/src/pc_costume.c
@@ -0,0 +1,1510 @@
+/* Optional costume pieces from mods/halloween.shc — see pc_costume.h.
+ *
+ * Rigid pieces ride one bone. Chains (tails) are a verlet rope in world space:
+ * each joint is pulled toward its rest position on the bone (stiffer near the
+ * base), keeps its segment length, sags with gravity and swishes sideways, so
+ * it lags and swings when the character turns or walks. Cloth (the ghost
+ * sheet) is a grid of such strands, linked across as well and pushed out of
+ * the character's limbs, pinned along its top row. Everything is then
+ * expressed in root-bone space and drawn as one mesh: transform, shade
+ * with the stock lights, emit textured triangles. */
+
+#include "game.h"
+#include "inline_no_dmpsx.h"
+
+#include <psyq/gtemac.h>
+
+#include "bodyprog/bodyprog.h"
+#include "bodyprog/gfx/world.h"
+#include "bodyprog/screen/screen_data.h"
+#include "bodyprog/math/math.h"
+#include "bodyprog/sys/joy.h"
+#include "bodyprog/view/vw_calc.h"
+#include "bodyprog/view/vw_system.h"
+
+#include <errno.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "hires_override.h"
+#include "pc_config.h"
+#include "pc_costume.h"
+#include "sh_log.h"
+
+extern s_WorldEnvWork g_WorldEnvWork; /* writable view, as in pc_wide_lm_draw.c */
+extern void    func_80057228(MATRIX* mat, s32 alpha, SVECTOR* arg2, VECTOR3* arg3);
+extern PACKET* Pc_PacketBuf_End(void);
+extern int     PsyX_PGXP_TriBackface(const void* a, const void* b, const void* c, int nclip);
+extern void    PsyX_SetNextPrimSzActor(unsigned short s0, unsigned short s1, unsigned short s2,
+                                        unsigned short s3, int n);
+
+#define COSTUME_PACK_PATH  "mods/halloween.shc"
+#define COSTUME_MAX_PIECES 32
+#define COSTUME_MAX_RINGS  255 /* a vert names its ring in a u8 */
+#define COSTUME_FLAG_CHAIN 1
+#define COSTUME_FLAG_FPS   2
+#define COSTUME_FLAG_CLOTH 4
+#define COSTUME_FLAG_PROP  8 /* a world prop: no bone; placed by the pack's placement list */
+#define COSTUME_MOVING     (COSTUME_FLAG_CHAIN | COSTUME_FLAG_CLOTH)
+#define COSTUME_PROP_CHARA 63 /* props' chara field: matches no character */
+#define COSTUME_MAX_PLACES 512
+/* Build with COSTUME_MARKS for the mark-spot combo (L1+R1+L2+R2 logs a [MARK]
+ * line and drops a jack there for the session). */
+#define COSTUME_MAX_MARKS  32
+#define COSTUME_MARK_COMBO (ControllerFlag_L1 | ControllerFlag_R1 | ControllerFlag_L2 | ControllerFlag_R2)
+#define COSTUME_GRAVITY    2450.0f /* model units/s^2: Harry is ~440 units tall */
+#define COSTUME_TURN_LAG   6.5f    /* frames of heading the chain tip trails by */
+#define COSTUME_TURN_MAX   0.75f   /* radians */
+#define COSTUME_SWAY_BOB   0.5f    /* up-down swish, as a share of the sideways one */
+
+/* Clear of the other hires pool slots (up to 503). */
+#define COSTUME_POOL_SLOT 505
+#define COSTUME_SLOT_CLUT(slot) \
+    ((u16)(((HIRES_POOL_CLUT_ROW_BASE + ((slot) / 64) * HIRES_POOL_MAX_ROWS) << 6) | ((slot) % 64)))
+
+/* Same per-prim guards as the stock emit (see pc_wide_lm_draw.c). */
+#define COSTUME_FOG_FAR_DIST() (g_PcConfig.disableCulling ? 0x7FFFFFFF : g_WorldEnvWork.fog.farDistance)
+#define COSTUME_SCREEN_BOUND   1024
+#define COSTUME_VERTEX_OOB(packed) \
+    ((s16)((packed) & 0xFFFF) < -COSTUME_SCREEN_BOUND || (s16)((packed) & 0xFFFF) > COSTUME_SCREEN_BOUND || \
+     (s16)(((packed) >> 16) & 0xFFFF) < -COSTUME_SCREEN_BOUND || (s16)(((packed) >> 16) & 0xFFFF) > COSTUME_SCREEN_BOUND)
+#define COSTUME_SCREEN_Z_TO_FOG(z) ({ \
+    s32 _z = (s32)(z); s32 _fb; \
+    if (!g_WorldEnvWork.isFogEnabled) { _fb = 0; } \
+    else if (_z < (1 << g_WorldEnvWork.fog.depthShift)) { \
+        s32 _idx = (_z << 7) >> g_WorldEnvWork.fog.depthShift; \
+        if (_idx < 0) { _idx = 0; } \
+        if (_idx > 127) { _idx = 127; } \
+        _fb = g_WorldEnvWork.fogRamp[_idx]; \
+    } else { _fb = 255; } \
+    (u8)((_fb * 127) >> 8); })
+#define COSTUME_STRGB3_VEC(r0) do {                  \
+        *(u32*)((char*)(r0) + 0) = MFC2(20);         \
+        *(u32*)((char*)(r0) + 4) = MFC2(21);         \
+        *(u32*)((char*)(r0) + 8) = MFC2(22);         \
+    } while (0)
+
+typedef struct
+{
+    float pos[3];
+    float nrm[3];
+    u16   uv; /* u | (v << 8) */
+    u8    ring;
+} s_CostumeVert;
+
+typedef struct
+{
+    s32            chara;
+    s32            bone;
+    u32            flags;
+    u32            hideMask;
+    u32            ringCount, vertCount, triCount;
+    float          stiffBase, stiffTip, damping, gravity, swayAmp, swayHz;
+    float          (*rest)[3];
+    s_CostumeVert* verts;
+    u16*           tris;
+
+    /* Cloth only: rings are strands x rows, strand by strand; row 0 is pinned. */
+    u32   strands;
+    float collideRadius;
+    u32   collideMask;
+
+    /* Chain/cloth state in world space (p, prev, tgt), and the joints and
+     * frames in root space for this draw (q, fr). */
+    int   live;
+    s32   lastFrame;
+    float clock;
+    float lastYaw, turn; /* root heading, and its smoothed change per 30 fps frame */
+    float (*p)[3];
+    float (*prev)[3];
+    float (*tgt)[3];
+    float (*q)[3];
+    float (*fr)[9];
+} s_CostumePiece;
+
+/* A prop standing in a map: world position (Q12, y down, at its base) and a
+ * heading (Q12 turn) its +Z faces. */
+typedef struct
+{
+    s32 map;
+    u32 piece;
+    s32 yaw;
+    s32 x, y, z;
+} s_CostumePlace;
+
+static struct
+{
+    int            state;    /* 0 untried, 1 loaded, -1 none/failed */
+    int            texState; /* 0 not registered, 1 registered, -1 failed */
+    u32            pieceCount;
+    s_CostumePiece pieces[COSTUME_MAX_PIECES];
+    u8*            texRgba;
+    u32            texW, texH;
+    u32            maxVerts; /* most verts any one character draws, or any one prop */
+
+    s_CostumePlace* places;
+    u32             placeCount;
+    s_CostumePlace  marks[COSTUME_MAX_MARKS]; /* dropped by the mark-spot combo this session */
+    u32             markCount;
+    s32             markPiece; /* first prop piece, or -1 */
+    int             markHeld;
+
+    s32 chara; /* current character, -1 outside a skeleton draw */
+    s32 frame; /* game frames seen (g_ActiveBufferIdx flips once per frame) */
+    s32 lastBuf;
+    u32 hide;
+    int any;
+
+    SVECTOR* sv;
+    SVECTOR* sn;
+    DVECTOR* xy;
+    s16*     z;
+    s32*     shade;
+} s_costume = { 0, 0, 0, { { 0 } }, NULL, 0, 0, 0, NULL, 0, { { 0 } }, 0, -1, 0, -1, 0, -1 };
+
+static int Costume_Load(void)
+{
+    FILE*  f;
+    long   size;
+    u8*    d;
+    size_t o;
+    u32    hdr[4];
+    u32    i, j;
+    u32    perChara[64];
+    int    ok = 0;
+
+    f = fopen(COSTUME_PACK_PATH, "rb");
+    if (f == NULL)
+    {
+        SH_DBG("[COSTUME] no %s (%s)", COSTUME_PACK_PATH, strerror(errno));
+        return 0;
+    }
+    fseek(f, 0, SEEK_END);
+    size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    d = (u8*)malloc((size_t)size);
+    if (d == NULL || fread(d, 1, (size_t)size, f) != (size_t)size)
+    {
+        fclose(f);
+        free(d);
+        return 0;
+    }
+    fclose(f);
+
+#define NEED(n) do { if (o + (size_t)(n) > (size_t)size) goto done; } while (0)
+    o = 0;
+    NEED(20);
+    if (memcmp(d, "SHCP", 4) != 0)
+    {
+        goto done;
+    }
+    memcpy(hdr, d + 4, sizeof(hdr));
+    o = 20;
+    if ((hdr[0] != 1 && hdr[0] != 2) || hdr[1] == 0 || hdr[1] > COSTUME_MAX_PIECES || hdr[2] != 256 || hdr[3] != 256)
+    {
+        goto done;
+    }
+    s_costume.texW = hdr[2];
+    s_costume.texH = hdr[3];
+    NEED(hdr[2] * hdr[3] * 4);
+    s_costume.texRgba = (u8*)malloc(hdr[2] * hdr[3] * 4);
+    if (s_costume.texRgba == NULL)
+    {
+        goto done;
+    }
+    memcpy(s_costume.texRgba, d + o, hdr[2] * hdr[3] * 4);
+    o += hdr[2] * hdr[3] * 4;
+
+    memset(perChara, 0, sizeof(perChara));
+    for (i = 0; i < hdr[1]; i++)
+    {
+        s_CostumePiece* p = &s_costume.pieces[i];
+        u32             ph[7];
+        float           pf[6];
+
+        NEED(52);
+        memcpy(ph, d + o, sizeof(ph));
+        memcpy(pf, d + o + 28, sizeof(pf));
+        o += 52;
+        if (ph[0] >= 64 || ph[1] >= 32 || ph[4] > COSTUME_MAX_RINGS || ph[5] == 0 || ph[5] > 0xFFFF ||
+            ((ph[2] & COSTUME_FLAG_CHAIN) && ph[4] < 2) || (ph[2] & COSTUME_MOVING) == COSTUME_MOVING ||
+            ((ph[2] & COSTUME_FLAG_PROP) && ((ph[2] & COSTUME_MOVING) || ph[0] != COSTUME_PROP_CHARA)))
+        {
+            goto done;
+        }
+        if (ph[2] & COSTUME_FLAG_CLOTH)
+        {
+            u32 cx[3];
+
+            NEED(12);
+            memcpy(cx, d + o, sizeof(cx));
+            o += 12;
+            if (cx[0] < 3 || ph[4] % cx[0] != 0 || ph[4] / cx[0] < 2)
+            {
+                goto done;
+            }
+            p->strands = cx[0];
+            memcpy(&p->collideRadius, &cx[1], 4);
+            p->collideMask = cx[2];
+        }
+        p->chara     = (s32)ph[0];
+        p->bone      = (s32)ph[1];
+        p->flags     = ph[2];
+        p->hideMask  = ph[3];
+        p->ringCount = ph[4];
+        p->vertCount = ph[5];
+        p->triCount  = ph[6];
+        p->stiffBase = pf[0];
+        p->stiffTip  = pf[1];
+        p->damping   = pf[2];
+        p->gravity   = pf[3];
+        p->swayAmp   = pf[4];
+        p->swayHz    = pf[5];
+
+        NEED(p->ringCount * 12 + p->vertCount * 28 + p->triCount * 6);
+        p->rest  = malloc(sizeof(float[3]) * (p->ringCount ? p->ringCount : 1));
+        p->verts = (s_CostumeVert*)malloc(sizeof(s_CostumeVert) * p->vertCount);
+        p->tris  = (u16*)malloc(sizeof(u16) * 3 * (p->triCount ? p->triCount : 1));
+        if (p->rest == NULL || p->verts == NULL || p->tris == NULL)
+        {
+            goto done;
+        }
+        if (p->flags & COSTUME_MOVING)
+        {
+            p->p    = malloc(sizeof(float[3]) * p->ringCount);
+            p->prev = malloc(sizeof(float[3]) * p->ringCount);
+            p->tgt  = malloc(sizeof(float[3]) * p->ringCount);
+            p->q    = malloc(sizeof(float[3]) * p->ringCount);
+            p->fr   = malloc(sizeof(float[9]) * p->ringCount);
+            if (p->p == NULL || p->prev == NULL || p->tgt == NULL || p->q == NULL || p->fr == NULL)
+            {
+                goto done;
+            }
+        }
+        memcpy(p->rest, d + o, p->ringCount * 12);
+        o += p->ringCount * 12;
+        for (j = 0; j < p->vertCount; j++, o += 28)
+        {
+            s_CostumeVert* v = &p->verts[j];
+
+            memcpy(v->pos, d + o, 12);
+            memcpy(v->nrm, d + o + 12, 12);
+            v->uv   = (u16)(d[o + 24] | (d[o + 25] << 8));
+            v->ring = d[o + 26];
+            if ((p->flags & COSTUME_MOVING) && v->ring >= p->ringCount)
+            {
+                goto done;
+            }
+        }
+        memcpy(p->tris, d + o, p->triCount * 6);
+        o += p->triCount * 6;
+        for (j = 0; j < p->triCount * 3; j++)
+        {
+            if (p->tris[j] >= p->vertCount)
+            {
+                goto done;
+            }
+        }
+        if (p->flags & COSTUME_FLAG_PROP)
+        {
+            if (p->vertCount > s_costume.maxVerts)
+            {
+                s_costume.maxVerts = p->vertCount;
+            }
+            if (s_costume.markPiece < 0)
+            {
+                s_costume.markPiece = (s32)i;
+            }
+        }
+        else
+        {
+            perChara[p->chara] += p->vertCount;
+        }
+        s_costume.pieceCount = i + 1;
+    }
+
+    /* Version 2: placements, 16 bytes each (u8 map, u8 piece, u16 yaw, s32 x, y, z);
+     * yaw bit 15 = sit on the floor (y ignored). */
+    if (hdr[0] >= 2)
+    {
+        u32 count;
+
+        NEED(4);
+        memcpy(&count, d + o, 4);
+        o += 4;
+        if (count > COSTUME_MAX_PLACES)
+        {
+            goto done;
+        }
+        NEED(count * 16);
+        s_costume.places = (s_CostumePlace*)malloc(sizeof(s_CostumePlace) * (count ? count : 1));
+        if (s_costume.places == NULL)
+        {
+            goto done;
+        }
+        for (i = 0; i < count; i++, o += 16)
+        {
+            s_CostumePlace* pl = &s_costume.places[i];
+            s32             xyz[3];
+
+            pl->map   = d[o];
+            pl->piece = d[o + 1];
+            pl->yaw   = (s32)(d[o + 2] | (d[o + 3] << 8)) & 0xFFF;
+            memcpy(xyz, d + o + 4, 12);
+            pl->x = xyz[0];
+            pl->y = xyz[1];
+            pl->z = xyz[2];
+            if (pl->piece >= s_costume.pieceCount || !(s_costume.pieces[pl->piece].flags & COSTUME_FLAG_PROP))
+            {
+                goto done;
+            }
+        }
+        s_costume.placeCount = count;
+    }
+#undef NEED
+
+    for (i = 0; i < 64; i++)
+    {
+        if (perChara[i] > s_costume.maxVerts)
+        {
+            s_costume.maxVerts = perChara[i];
+        }
+    }
+    j = s_costume.maxVerts + 2;
+    s_costume.sv    = (SVECTOR*)malloc(sizeof(SVECTOR) * j);
+    s_costume.sn    = (SVECTOR*)malloc(sizeof(SVECTOR) * j);
+    s_costume.xy    = (DVECTOR*)malloc(sizeof(DVECTOR) * j);
+    s_costume.z     = (s16*)malloc(sizeof(s16) * j);
+    s_costume.shade = (s32*)malloc(sizeof(s32) * j);
+    if (s_costume.sv != NULL && s_costume.sn != NULL && s_costume.xy != NULL && s_costume.z != NULL &&
+        s_costume.shade != NULL)
+    {
+        ok = 1;
+        SH_DBG("[COSTUME] loaded %u pieces, %u prop placements, up to %u verts per draw", s_costume.pieceCount,
+               s_costume.placeCount, s_costume.maxVerts);
+    }
+
+done:
+    if (!ok)
+    {
+        SH_DBG("[COSTUME] %s is malformed (stopped at byte %u); no costumes", COSTUME_PACK_PATH, (unsigned)o);
+        s_costume.pieceCount = 0;
+        s_costume.placeCount = 0;
+        s_costume.markPiece  = -1;
+    }
+    free(d);
+    return ok;
+}
+
+/* GL uploads need the live context, so they wait for the first draw. */
+static int Costume_TextureReady(void)
+{
+    if (s_costume.texState == 0)
+    {
+        s_costume.texState = 1;
+        if (HiresOverride_PoolSlotRegisterRGBA(COSTUME_POOL_SLOT, 0, s_costume.texRgba, (int)s_costume.texW,
+                                               (int)s_costume.texH, 256, 256) != 0)
+        {
+            SH_DBG("[COSTUME] texture upload failed; no costumes");
+            s_costume.texState = -1;
+        }
+        else
+        {
+            HiresOverride_PoolSlotSetNoClamp(COSTUME_POOL_SLOT, 1);
+        }
+        free(s_costume.texRgba);
+        s_costume.texRgba = NULL;
+    }
+    return s_costume.texState == 1;
+}
+
+void Pc_Costume_BeginChara(s32 charaId)
+{
+    u32 i;
+
+    if (s_costume.state == 0)
+    {
+        s_costume.state = Costume_Load() ? 1 : -1;
+    }
+    if (g_ActiveBufferIdx != s_costume.lastBuf)
+    {
+        s_costume.lastBuf = g_ActiveBufferIdx;
+        s_costume.frame++;
+    }
+    s_costume.chara = charaId;
+    s_costume.hide  = 0;
+    s_costume.any   = 0;
+    if (s_costume.state != 1 || s_costume.texState == -1)
+    {
+        return;
+    }
+    for (i = 0; i < s_costume.pieceCount; i++)
+    {
+        if (s_costume.pieces[i].chara == charaId && !(s_costume.pieces[i].flags & COSTUME_FLAG_PROP))
+        {
+            s_costume.any = 1;
+            s_costume.hide |= s_costume.pieces[i].hideMask;
+        }
+    }
+}
+
+void Pc_Costume_EndChara(void)
+{
+    s_costume.chara = -1;
+    s_costume.hide  = 0;
+    s_costume.any   = 0;
+}
+
+int Pc_Costume_Active(void)
+{
+    return s_costume.any;
+}
+
+int Pc_Costume_HideBone(s32 boneIdx)
+{
+    return boneIdx >= 0 && boneIdx < 32 && ((s_costume.hide >> boneIdx) & 1);
+}
+
+GsOT* Pc_Costume_ScratchOt(void)
+{
+    /* Bucket offsets reach 99 (func_800571D0) plus a depth index below
+     * ORDERING_TABLE_SIZE. Never drawn; ClearOTag is unnecessary. */
+    static GsOT_TAG s_tags[ORDERING_TABLE_SIZE + 128];
+    static GsOT     s_ot;
+
+    s_ot.length = 0;
+    s_ot.org    = s_tags;
+    return &s_ot;
+}
+
+/* 3x3 row-major helpers. */
+static void M3_Mul(const float* a, const float* b, float* out)
+{
+    int r, c;
+
+    for (r = 0; r < 3; r++)
+    {
+        for (c = 0; c < 3; c++)
+        {
+            out[r * 3 + c] = a[r * 3 + 0] * b[0 * 3 + c] + a[r * 3 + 1] * b[1 * 3 + c] + a[r * 3 + 2] * b[2 * 3 + c];
+        }
+    }
+}
+
+static void M3_Vec(const float* m, const float* v, float* out)
+{
+    out[0] = m[0] * v[0] + m[1] * v[1] + m[2] * v[2];
+    out[1] = m[3] * v[0] + m[4] * v[1] + m[5] * v[2];
+    out[2] = m[6] * v[0] + m[7] * v[1] + m[8] * v[2];
+}
+
+static int M3_Inverse(const float* m, float* out)
+{
+    float det = m[0] * (m[4] * m[8] - m[5] * m[7]) - m[1] * (m[3] * m[8] - m[5] * m[6]) +
+                m[2] * (m[3] * m[7] - m[4] * m[6]);
+    float k;
+
+    if (fabsf(det) < 1e-9f)
+    {
+        return 0;
+    }
+    k      = 1.0f / det;
+    out[0] = (m[4] * m[8] - m[5] * m[7]) * k;
+    out[1] = (m[2] * m[7] - m[1] * m[8]) * k;
+    out[2] = (m[1] * m[5] - m[2] * m[4]) * k;
+    out[3] = (m[5] * m[6] - m[3] * m[8]) * k;
+    out[4] = (m[0] * m[8] - m[2] * m[6]) * k;
+    out[5] = (m[2] * m[3] - m[0] * m[5]) * k;
+    out[6] = (m[3] * m[7] - m[4] * m[6]) * k;
+    out[7] = (m[1] * m[6] - m[0] * m[7]) * k;
+    out[8] = (m[0] * m[4] - m[1] * m[3]) * k;
+    return 1;
+}
+
+static void V3_Norm(float* v)
+{
+    float l = sqrtf(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+
+    if (l > 1e-6f)
+    {
+        v[0] /= l;
+        v[1] /= l;
+        v[2] /= l;
+    }
+}
+
+static s16 Costume_S16(float f)
+{
+    f = floorf(f + 0.5f);
+    return (s16)(f < -32768.0f ? -32768.0f : (f > 32767.0f ? 32767.0f : f));
+}
+
+/* Root-relative rotation W and position T of bone from the local coords, as
+ * the coords' cached workm can lag late overrides. */
+static int Costume_BonePose(GsCOORDINATE2* bc, s32 bone, float W[9], float T[3])
+{
+    GsCOORDINATE2* chain[24];
+    GsCOORDINATE2* c = &bc[bone];
+    int            n = 0;
+    int            i, r, k;
+
+    while (c != &bc[0])
+    {
+        if (c == NULL || n >= 24)
+        {
+            return 0;
+        }
+        chain[n++] = c;
+        c          = c->super;
+    }
+    memset(W, 0, sizeof(float) * 9);
+    W[0] = W[4] = W[8] = 1.0f;
+    T[0] = T[1] = T[2] = 0.0f;
+    for (i = n - 1; i >= 0; i--)
+    {
+        float m[9], t[3], wt[3], nw[9];
+
+        for (r = 0; r < 3; r++)
+        {
+            for (k = 0; k < 3; k++)
+            {
+                m[r * 3 + k] = chain[i]->coord.m[r][k] * (1.0f / 4096.0f);
+            }
+            t[r] = (float)chain[i]->coord.t[r];
+        }
+        M3_Vec(W, t, wt);
+        T[0] += wt[0];
+        T[1] += wt[1];
+        T[2] += wt[2];
+        M3_Mul(W, m, nw);
+        memcpy(W, nw, sizeof(nw));
+    }
+    return 1;
+}
+
+/* Step a chain's rope (once per game frame) and write its joints in root
+ * space (Q) with frames (X, Y along the cross-section, Z along the chain). */
+static void Costume_Chain(s_CostumePiece* p, const float* W, const float* T, const float* Rw, const float* tw,
+                          const float* RwInv, float Q[][3], float F[][9])
+{
+    float (*tgt)[3] = p->tgt;
+    float dt   = (float)g_DeltaTime * (1.0f / 4096.0f);
+    u32   n    = p->ringCount;
+    s32   frm  = s_costume.frame;
+    float yaw  = atan2f(Rw[2], Rw[8]); /* heading of root +Z, matching the rotation below */
+    float lagC, lagS;
+    float side[3];
+    u32   i;
+
+    /* Swing out on turns: track how fast the root turns, and aim the chain
+     * back the way it came, more toward the tip. */
+    if (p->live && frm != p->lastFrame && dt > 0.0f)
+    {
+        float s  = (dt > 0.1f ? 0.1f : dt) * 30.0f;
+        float dy = yaw - p->lastYaw;
+
+        if (dy > 3.14159265f)
+        {
+            dy -= 6.2831853f;
+        }
+        else if (dy < -3.14159265f)
+        {
+            dy += 6.2831853f;
+        }
+        p->turn += (dy / s - p->turn) * (1.0f - powf(0.75f, s));
+    }
+    p->lastYaw = yaw;
+
+    for (i = 0; i < n; i++)
+    {
+        float f = (float)i / (float)(n - 1);
+        float b[3], q[3];
+        float a = -p->turn * COSTUME_TURN_LAG * f * sqrtf(f);
+
+        if (a > COSTUME_TURN_MAX)
+        {
+            a = COSTUME_TURN_MAX;
+        }
+        else if (a < -COSTUME_TURN_MAX)
+        {
+            a = -COSTUME_TURN_MAX;
+        }
+        lagC = cosf(a);
+        lagS = sinf(a);
+
+        /* Swish along the bone's X, growing toward the tip. */
+        b[0] = p->rest[i][0] + p->swayAmp * f * sqrtf(f) * sinf(6.2831853f * p->swayHz * p->clock - 1.3f * f);
+        /* ...and a slower-than-double bob along Y, so the tip traces a lazy loop. */
+        b[1] = p->rest[i][1] + COSTUME_SWAY_BOB * p->swayAmp * f * sqrtf(f) *
+                                   sinf(6.2831853f * p->swayHz * 1.7f * p->clock - 1.3f * f + 0.8f);
+        b[2] = p->rest[i][2];
+        M3_Vec(W, b, q);
+        q[0] += T[0];
+        q[1] += T[1];
+        q[2] += T[2];
+        M3_Vec(Rw, q, tgt[i]);
+        {
+            /* Turn lag: rotate about the world vertical through the root. */
+            float x = tgt[i][0], z = tgt[i][2];
+
+            tgt[i][0] = x * lagC + z * lagS;
+            tgt[i][2] = -x * lagS + z * lagC;
+        }
+        tgt[i][0] += tw[0];
+        tgt[i][1] += tw[1];
+        tgt[i][2] += tw[2];
+    }
+
+    {
+        float dx = p->p[0][0] - tgt[0][0], dy = p->p[0][1] - tgt[0][1], dz = p->p[0][2] - tgt[0][2];
+
+        /* First sight, a long gap or a teleport (room change, cutscene cut): start at rest. */
+        if (!p->live || frm - p->lastFrame > 4 || frm < p->lastFrame || dx * dx + dy * dy + dz * dz > 300.0f * 300.0f)
+        {
+            memcpy(p->p, tgt, sizeof(float[3]) * n);
+            memcpy(p->prev, tgt, sizeof(float[3]) * n);
+            p->turn      = 0.0f;
+            p->live      = 1;
+            p->lastFrame = frm;
+        }
+    }
+
+    if (frm != p->lastFrame && dt > 0.0f)
+    {
+        float s    = (dt > 0.1f ? 0.1f : dt) * 30.0f; /* 1 at 30 fps */
+        float damp = powf(p->damping, s);
+        float g    = p->gravity * COSTUME_GRAVITY * (s / 30.0f) * (s / 30.0f);
+        int   it;
+
+        memcpy(p->p[0], tgt[0], sizeof(tgt[0]));
+        memcpy(p->prev[0], tgt[0], sizeof(tgt[0]));
+        for (i = 1; i < n; i++)
+        {
+            float f = (float)i / (float)(n - 1);
+            float k = 1.0f - powf(1.0f - (p->stiffBase + (p->stiffTip - p->stiffBase) * f), s);
+            int   c;
+
+            for (c = 0; c < 3; c++)
+            {
+                float v = (p->p[i][c] - p->prev[i][c]) * damp;
+
+                p->prev[i][c] = p->p[i][c];
+                p->p[i][c] += v;
+            }
+            p->p[i][1] += g;
+            for (c = 0; c < 3; c++)
+            {
+                p->p[i][c] += (tgt[i][c] - p->p[i][c]) * k;
+            }
+        }
+        for (it = 0; it < 2; it++)
+        {
+            for (i = 1; i < n; i++)
+            {
+                float rd[3] = { p->rest[i][0] - p->rest[i - 1][0], p->rest[i][1] - p->rest[i - 1][1],
+                                p->rest[i][2] - p->rest[i - 1][2] };
+                float d[3]  = { p->p[i][0] - p->p[i - 1][0], p->p[i][1] - p->p[i - 1][1], p->p[i][2] - p->p[i - 1][2] };
+                float len   = sqrtf(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
+                float want  = sqrtf(rd[0] * rd[0] + rd[1] * rd[1] + rd[2] * rd[2]);
+                int   c;
+
+                if (len > 1e-4f)
+                {
+                    for (c = 0; c < 3; c++)
+                    {
+                        p->p[i][c] = p->p[i - 1][c] + d[c] * (want / len);
+                    }
+                }
+            }
+        }
+        p->lastFrame = frm;
+        p->clock += dt;
+    }
+    else if (frm != p->lastFrame)
+    {
+        /* Paused (no time passed): hold the pose, keep the base on the bone. */
+        p->lastFrame = frm;
+    }
+
+    for (i = 0; i < n; i++)
+    {
+        float d[3] = { p->p[i][0] - tw[0], p->p[i][1] - tw[1], p->p[i][2] - tw[2] };
+
+        M3_Vec(RwInv, d, Q[i]);
+    }
+
+    side[0] = W[0];
+    side[1] = W[3];
+    side[2] = W[6];
+    for (i = 0; i < n; i++)
+    {
+        const float* a  = Q[i == n - 1 ? i : i + 1];
+        const float* b  = Q[i == 0 ? 0 : i - 1];
+        float*       fx = &F[i][0];
+        float*       fy = &F[i][3];
+        float*       fz = &F[i][6];
+        float        dp;
+
+        fz[0] = a[0] - b[0];
+        fz[1] = a[1] - b[1];
+        fz[2] = a[2] - b[2];
+        V3_Norm(fz);
+        dp    = side[0] * fz[0] + side[1] * fz[1] + side[2] * fz[2];
+        fx[0] = side[0] - fz[0] * dp;
+        fx[1] = side[1] - fz[1] * dp;
+        fx[2] = side[2] - fz[2] * dp;
+        if (fx[0] * fx[0] + fx[1] * fx[1] + fx[2] * fx[2] < 1e-4f)
+        {
+            fx[0] = -fz[1] * fz[0];
+            fx[1] = 1.0f - fz[1] * fz[1];
+            fx[2] = -fz[1] * fz[2];
+        }
+        V3_Norm(fx);
+        fy[0] = fz[1] * fx[2] - fz[2] * fx[1];
+        fy[1] = fz[2] * fx[0] - fz[0] * fx[2];
+        fy[2] = fz[0] * fx[1] - fz[1] * fx[0];
+    }
+}
+
+/* Pull particles a and b back to their rest distance (b alone when a is pinned). */
+static void Costume_Link(s_CostumePiece* p, u32 a, u32 b, int pinA)
+{
+    float d[3]  = { p->p[b][0] - p->p[a][0], p->p[b][1] - p->p[a][1], p->p[b][2] - p->p[a][2] };
+    float rd[3] = { p->rest[b][0] - p->rest[a][0], p->rest[b][1] - p->rest[a][1], p->rest[b][2] - p->rest[a][2] };
+    float len   = sqrtf(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
+    float want  = sqrtf(rd[0] * rd[0] + rd[1] * rd[1] + rd[2] * rd[2]);
+    float k;
+    int   c;
+
+    if (len < 1e-4f)
+    {
+        return;
+    }
+    k = (len - want) / len;
+    for (c = 0; c < 3; c++)
+    {
+        if (pinA)
+        {
+            p->p[b][c] -= d[c] * k;
+        }
+        else
+        {
+            p->p[a][c] += d[c] * k * 0.5f;
+            p->p[b][c] -= d[c] * k * 0.5f;
+        }
+    }
+}
+
+/* Push x out of the capsule a-b of radius rad. */
+static void Costume_PushOut(float* x, const float* a, const float* b, float rad)
+{
+    float ab[3] = { b[0] - a[0], b[1] - a[1], b[2] - a[2] };
+    float ll    = ab[0] * ab[0] + ab[1] * ab[1] + ab[2] * ab[2];
+    float t     = 0.0f;
+    float d[3], l;
+    int   c;
+
+    if (ll > 1e-6f)
+    {
+        t = ((x[0] - a[0]) * ab[0] + (x[1] - a[1]) * ab[1] + (x[2] - a[2]) * ab[2]) / ll;
+        t = t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t);
+    }
+    for (c = 0; c < 3; c++)
+    {
+        d[c] = x[c] - (a[c] + ab[c] * t);
+    }
+    l = sqrtf(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
+    if (l >= rad || l < 1e-3f)
+    {
+        return;
+    }
+    for (c = 0; c < 3; c++)
+    {
+        x[c] += d[c] * (rad / l - 1.0f);
+    }
+}
+
+/* Step a cloth (once per game frame): row 0 rides the bone, the other rows
+ * spring toward their rest place, sag, keep their spacing down and across the
+ * strands, and are pushed out of the limbs in collideMask (each a capsule from
+ * the bone's parent joint to its own). Writes root-space joints and frames
+ * (Z down the strand, X toward the next strand) to p->q / p->fr. */
+static void Costume_Cloth(s_CostumePiece* p, GsCOORDINATE2* bc, const float* W, const float* T, const float* Rw,
+                          const float* tw, const float* RwInv)
+{
+    float caps[32][2][3];
+    u32   capCount = 0;
+    u32   K        = p->strands;
+    u32   M        = p->ringCount / K;
+    u32   n        = p->ringCount;
+    float dt       = (float)g_DeltaTime * (1.0f / 4096.0f);
+    s32   frm      = s_costume.frame;
+    u32   i, s, j;
+
+    for (i = 0; i < n; i++)
+    {
+        float q[3];
+
+        M3_Vec(W, p->rest[i], q);
+        q[0] += T[0];
+        q[1] += T[1];
+        q[2] += T[2];
+        M3_Vec(Rw, q, p->tgt[i]);
+        p->tgt[i][0] += tw[0];
+        p->tgt[i][1] += tw[1];
+        p->tgt[i][2] += tw[2];
+    }
+
+    {
+        float dx = p->p[0][0] - p->tgt[0][0], dy = p->p[0][1] - p->tgt[0][1], dz = p->p[0][2] - p->tgt[0][2];
+
+        if (!p->live || frm - p->lastFrame > 4 || frm < p->lastFrame || dx * dx + dy * dy + dz * dz > 300.0f * 300.0f)
+        {
+            memcpy(p->p, p->tgt, sizeof(float[3]) * n);
+            memcpy(p->prev, p->tgt, sizeof(float[3]) * n);
+            p->live      = 1;
+            p->lastFrame = frm;
+        }
+    }
+
+    if (frm != p->lastFrame && dt > 0.0f)
+    {
+        float st   = (dt > 0.1f ? 0.1f : dt) * 30.0f; /* 1 at 30 fps */
+        float damp = powf(p->damping, st);
+        float g    = p->gravity * COSTUME_GRAVITY * (st / 30.0f) * (st / 30.0f);
+        u32   b;
+        int   it;
+
+        for (b = 0; b < 32; b++)
+        {
+            float W2[9], T2[3];
+            s32   parent;
+
+            if (!((p->collideMask >> b) & 1) || bc[b].super == NULL)
+            {
+                continue;
+            }
+            parent = (s32)(bc[b].super - bc);
+            if (parent < 0 || parent >= 32 || !Costume_BonePose(bc, (s32)b, W2, T2))
+            {
+                continue;
+            }
+            M3_Vec(Rw, T2, caps[capCount][1]);
+            if (!Costume_BonePose(bc, parent, W2, T2))
+            {
+                continue;
+            }
+            M3_Vec(Rw, T2, caps[capCount][0]);
+            for (i = 0; i < 3; i++)
+            {
+                caps[capCount][0][i] += tw[i];
+                caps[capCount][1][i] += tw[i];
+            }
+            capCount++;
+        }
+
+        for (s = 0; s < K; s++)
+        {
+            for (j = 0; j < M; j++)
+            {
+                u32   r = s * M + j;
+                float f = (float)j / (float)(M - 1);
+                float k = 1.0f - powf(1.0f - (p->stiffBase + (p->stiffTip - p->stiffBase) * f), st);
+                int   c;
+
+                if (j == 0)
+                {
+                    memcpy(p->p[r], p->tgt[r], sizeof(float[3]));
+                    memcpy(p->prev[r], p->tgt[r], sizeof(float[3]));
+                    continue;
+                }
+                for (c = 0; c < 3; c++)
+                {
+                    float v = (p->p[r][c] - p->prev[r][c]) * damp;
+
+                    p->prev[r][c] = p->p[r][c];
+                    p->p[r][c] += v;
+                }
+                p->p[r][1] += g;
+                for (c = 0; c < 3; c++)
+                {
+                    p->p[r][c] += (p->tgt[r][c] - p->p[r][c]) * k;
+                }
+            }
+        }
+        for (it = 0; it < 3; it++)
+        {
+            for (s = 0; s < K; s++)
+            {
+                for (j = 1; j < M; j++)
+                {
+                    Costume_Link(p, s * M + j - 1, s * M + j, j == 1);
+                    Costume_Link(p, s * M + j, ((s + 1) % K) * M + j, 0);
+                }
+            }
+            for (i = 0; i < n; i++)
+            {
+                if (i % M == 0)
+                {
+                    continue;
+                }
+                for (b = 0; b < capCount; b++)
+                {
+                    Costume_PushOut(p->p[i], caps[b][0], caps[b][1], p->collideRadius);
+                }
+            }
+        }
+        p->lastFrame = frm;
+        p->clock += dt;
+    }
+    else if (frm != p->lastFrame)
+    {
+        p->lastFrame = frm;
+    }
+
+    for (i = 0; i < n; i++)
+    {
+        float d[3] = { p->p[i][0] - tw[0], p->p[i][1] - tw[1], p->p[i][2] - tw[2] };
+
+        M3_Vec(RwInv, d, p->q[i]);
+    }
+    for (s = 0; s < K; s++)
+    {
+        for (j = 0; j < M; j++)
+        {
+            const float* dn0 = p->q[s * M + (j == 0 ? 0 : j - 1)];
+            const float* dn1 = p->q[s * M + (j == M - 1 ? j : j + 1)];
+            const float* ac0 = p->q[((s + K - 1) % K) * M + j];
+            const float* ac1 = p->q[((s + 1) % K) * M + j];
+            float*       fx  = &p->fr[s * M + j][0];
+            float*       fy  = &p->fr[s * M + j][3];
+            float*       fz  = &p->fr[s * M + j][6];
+            float        dp;
+            int          c;
+
+            for (c = 0; c < 3; c++)
+            {
+                fz[c] = dn1[c] - dn0[c];
+                fx[c] = ac1[c] - ac0[c];
+            }
+            V3_Norm(fz);
+            dp = fx[0] * fz[0] + fx[1] * fz[1] + fx[2] * fz[2];
+            for (c = 0; c < 3; c++)
+            {
+                fx[c] -= fz[c] * dp;
+            }
+            V3_Norm(fx);
+            fy[0] = fz[1] * fx[2] - fz[2] * fx[1];
+            fy[1] = fz[2] * fx[0] - fz[0] * fx[2];
+            fy[2] = fz[0] * fx[1] - fz[1] * fx[0];
+        }
+    }
+}
+
+/* Transform the posed costume verts to screen space. */
+static void Costume_Transform(MATRIX* viewMat, u32 vc)
+{
+    u32 i;
+
+    SetRotMatrix(viewMat);
+    SetTransMatrix(viewMat);
+    for (i = 0; i < vc; i += 3)
+    {
+        SVECTOR tri[3];
+        u32     j;
+
+        for (j = 0; j < 3; j++)
+        {
+            tri[j] = s_costume.sv[(i + j) < vc ? (i + j) : vc - 1];
+        }
+        gte_ldv3c(tri);
+        gte_rtpt();
+        gte_FetchScreen0_1_2_XYZ(&s_costume.xy[i], &s_costume.z[i]);
+    }
+}
+
+/* Light the costume verts with the scene's lights. */
+static void Costume_Shade(s_GteScratchData2* env, u32 nc)
+{
+    CVECTOR  sp0;
+    u32      groups = (nc + 2) / 3;
+    u32      g;
+    VECTOR3* out;
+
+    sp0.cd = 0;
+    gte_ldrgb(&sp0);
+    for (g = 0; g < groups; g++)
+    {
+        u32 j;
+
+        for (j = 0; j < 3; j++)
+        {
+            env->u.normal.field_3E0[j] = s_costume.sn[(g * 3 + j) < nc ? (g * 3 + j) : nc - 1];
+        }
+        if (g != 0)
+        {
+            COSTUME_STRGB3_VEC((VECTOR3*)&s_costume.shade[(g - 1) * 3]);
+        }
+        gte_ldv3c(env->u.normal.field_3E0);
+        gte_nct();
+    }
+    out = (VECTOR3*)&s_costume.shade[(groups - 1) * 3];
+    gte_strgb3(&out->vx, &out->vy, &out->vz);
+}
+
+static unsigned short Costume_Sz(s32 z)
+{
+    return (unsigned short)(z < 0 ? 0 : z > 0xFFFF ? 0xFFFF : z);
+}
+
+/* Emit the triangles of one piece whose verts start at base. Returns 1 when
+ * the packet arena is exhausted. */
+static int Costume_Emit(const s_CostumePiece* p, u32 base, s_GteScratchData2* env, GsOT_TAG* ot, s32 arg2, s32 lit,
+                        s32 farcap, u8* pktEnd)
+{
+    POLY_GT3* poly = (POLY_GT3*)GsOUT_PACKET_P;
+    u32       clut = COSTUME_SLOT_CLUT(COSTUME_POOL_SLOT);
+    u32       ti;
+    int       exhausted = 0;
+
+    for (ti = 0; ti < p->triCount; ti++)
+    {
+        const u16* t  = &p->tris[ti * 3];
+        u32        c0 = base + t[0], c1 = base + t[1], c2 = base + t[2];
+        s32        depth;
+        s32        r4;
+
+        if ((u8*)poly + sizeof(POLY_GT4) > pktEnd)
+        {
+            exhausted = 1;
+            break;
+        }
+
+        depth = (s_costume.z[c0] + s_costume.z[c1] + s_costume.z[c2] + s_costume.z[c2]) >> 2;
+        if (depth < 0 && Pc_WholeMapDrawActive())
+        {
+            depth = (ORDERING_TABLE_SIZE - 1) << (arg2 + 2);
+        }
+        if (depth <= 0 || farcap < depth)
+        {
+            continue;
+        }
+
+        gte_NormalClip(*(s32*)&s_costume.xy[c0], *(s32*)&s_costume.xy[c1], *(s32*)&s_costume.xy[c2], &r4);
+        if (PsyX_PGXP_TriBackface(&s_costume.xy[c0], &s_costume.xy[c1], &s_costume.xy[c2], r4))
+        {
+            continue;
+        }
+
+        *(s32*)&poly->x0 = *(s32*)&s_costume.xy[c0];
+        *(s32*)&poly->x1 = *(s32*)&s_costume.xy[c1];
+        *(s32*)&poly->x2 = *(s32*)&s_costume.xy[c2];
+        if (COSTUME_VERTEX_OOB(*(s32*)&poly->x0) || COSTUME_VERTEX_OOB(*(s32*)&poly->x1) ||
+            COSTUME_VERTEX_OOB(*(s32*)&poly->x2))
+        {
+            continue;
+        }
+        Shadow_Copy(&poly->x0, &s_costume.xy[c0]);
+        Shadow_Copy(&poly->x1, &s_costume.xy[c1]);
+        Shadow_Copy(&poly->x2, &s_costume.xy[c2]);
+
+        if (lit)
+        {
+            *(s32*)&poly->r0 = s_costume.shade[c0];
+            *(s32*)&poly->r1 = s_costume.shade[c1];
+            *(s32*)&poly->r2 = s_costume.shade[c2];
+        }
+        else
+        {
+            *(s32*)&poly->r0 = *(s32*)&poly->r1 = *(s32*)&poly->r2 = *(s32*)&env->field_3D8;
+        }
+        poly->code = 0x34;
+
+        *(s32*)&poly->u0 = (s32)((u32)p->verts[t[0]].uv | (clut << 16));
+        *(s32*)&poly->u1 = (s32)((u32)p->verts[t[1]].uv & 0xFFFFFF); /* tpage 0: 4bpp, opaque */
+        *(u16*)&poly->u2 = p->verts[t[2]].uv;
+
+        /* v0's fog, bit 15 = present. Left unset, it is last frame's packet
+         * bytes, and v0 fades to fog grey at random. */
+        poly->pad2 = (u16)(0x8000 | COSTUME_SCREEN_Z_TO_FOG(s_costume.z[c0]));
+        poly->p1 = COSTUME_SCREEN_Z_TO_FOG(s_costume.z[c1]);
+        poly->p2 = COSTUME_SCREEN_Z_TO_FOG(s_costume.z[c2]);
+
+        setlen(poly, 9);
+        if (((depth >> arg2) >> 2) >= ORDERING_TABLE_SIZE)
+        {
+            depth = (ORDERING_TABLE_SIZE - 1) << (arg2 + 2);
+        }
+        /* Per-vertex depth like the body's own prims (g_PsxActorDepth); unarmed,
+         * the prim takes a stale GTE depth and flickers against the body. */
+        PsyX_SetNextPrimSzActor(Costume_Sz(s_costume.z[c0]), Costume_Sz(s_costume.z[c1]),
+                                Costume_Sz(s_costume.z[c2]), Costume_Sz(s_costume.z[c2]), 3);
+        addPrim(&ot[(depth >> arg2) >> 2], poly);
+        poly++;
+    }
+    GsOUT_PACKET_P = (PACKET*)poly;
+    return exhausted;
+}
+
+void Pc_Costume_Draw(GsCOORDINATE2* boneCoords, GsOT_TAG* otTag, s32 arg2, u16 arg5, int firstPerson)
+{
+    static int        s_exhaustWarned = 0;
+    static int        s_drawLogged    = 0;
+    const s_CostumePiece* drawn[COSTUME_MAX_PIECES];
+    u32               bases[COSTUME_MAX_PIECES];
+    u32               drawnCount = 0;
+    MATRIX            rootWorld;
+    MATRIX            rootView;
+    float             Rw[9], tw[3], RwInv[9];
+    s_GteScratchData2 env;
+    u8*               pktEnd;
+    s32               lit;
+    s32               farcap;
+    u32               n = 0;
+    u32               i, j;
+
+    if (!s_costume.any || !Costume_TextureReady())
+    {
+        return;
+    }
+    pktEnd = (u8*)Pc_PacketBuf_End();
+    if (pktEnd == NULL)
+    {
+        return;
+    }
+
+    Vw_CoordToWorldAndViewMatrices(&boneCoords[0], &rootWorld, &rootView);
+    for (i = 0; i < 3; i++)
+    {
+        for (j = 0; j < 3; j++)
+        {
+            Rw[i * 3 + j] = rootWorld.m[i][j] * (1.0f / 4096.0f);
+        }
+        tw[i] = (float)rootWorld.t[i];
+    }
+    if (!M3_Inverse(Rw, RwInv))
+    {
+        return;
+    }
+
+    for (i = 0; i < s_costume.pieceCount; i++)
+    {
+        s_CostumePiece* p = &s_costume.pieces[i];
+        float           W[9], T[3];
+
+        if (p->chara != s_costume.chara || (p->flags & COSTUME_FLAG_PROP) ||
+            (firstPerson && (p->flags & COSTUME_FLAG_FPS)))
+        {
+            continue;
+        }
+        if (!Costume_BonePose(boneCoords, p->bone, W, T))
+        {
+            continue;
+        }
+
+        if (p->flags & COSTUME_MOVING)
+        {
+            float (*Q)[3] = p->q;
+
+            if (p->flags & COSTUME_FLAG_CLOTH)
+            {
+                Costume_Cloth(p, boneCoords, W, T, Rw, tw, RwInv);
+            }
+            else
+            {
+                Costume_Chain(p, W, T, Rw, tw, RwInv, p->q, p->fr);
+            }
+            for (j = 0; j < p->vertCount; j++)
+            {
+                const s_CostumeVert* v = &p->verts[j];
+                const float*         f = p->fr[v->ring];
+                float                q[3], nn[3];
+                int                  c;
+
+                for (c = 0; c < 3; c++)
+                {
+                    q[c]  = Q[v->ring][c] + f[c] * v->pos[0] + f[3 + c] * v->pos[1] + f[6 + c] * v->pos[2];
+                    nn[c] = f[c] * v->nrm[0] + f[3 + c] * v->nrm[1] + f[6 + c] * v->nrm[2];
+                }
+                s_costume.sv[n + j].vx = Costume_S16(q[0]);
+                s_costume.sv[n + j].vy = Costume_S16(q[1]);
+                s_costume.sv[n + j].vz = Costume_S16(q[2]);
+                s_costume.sn[n + j].vx = Costume_S16(nn[0] * 4064.0f);
+                s_costume.sn[n + j].vy = Costume_S16(nn[1] * 4064.0f);
+                s_costume.sn[n + j].vz = Costume_S16(nn[2] * 4064.0f);
+            }
+        }
+        else
+        {
+            for (j = 0; j < p->vertCount; j++)
+            {
+                const s_CostumeVert* v = &p->verts[j];
+                float                q[3], nn[3];
+
+                M3_Vec(W, v->pos, q);
+                M3_Vec(W, v->nrm, nn);
+                s_costume.sv[n + j].vx = Costume_S16(q[0] + T[0]);
+                s_costume.sv[n + j].vy = Costume_S16(q[1] + T[1]);
+                s_costume.sv[n + j].vz = Costume_S16(q[2] + T[2]);
+                s_costume.sn[n + j].vx = Costume_S16(nn[0] * 4064.0f);
+                s_costume.sn[n + j].vy = Costume_S16(nn[1] * 4064.0f);
+                s_costume.sn[n + j].vz = Costume_S16(nn[2] * 4064.0f);
+            }
+        }
+        drawn[drawnCount] = p;
+        bases[drawnCount] = n;
+        drawnCount++;
+        n += p->vertCount;
+    }
+    if (n == 0)
+    {
+        return;
+    }
+    if (!s_drawLogged)
+    {
+        s_drawLogged = 1;
+        SH_DBG("[COSTUME] first draw: chara %d, %u pieces, %u verts", (int)s_costume.chara, drawnCount, n);
+    }
+
+    if (g_WorldEnvWork.field_0 != 0)
+    {
+        func_80057228(&rootWorld, g_WorldEnvWork.field_54, &g_WorldEnvWork.field_58, &g_WorldEnvWork.field_60);
+    }
+    g_WorldEnvWork.field_14C = arg5;
+
+    switch (g_WorldEnvWork.field_0)
+    {
+        case 0:
+            func_8005A42C((s_GteScratchData*)&env, 256 << 4);
+            break;
+
+        case 1:
+            func_8005A478((s_GteScratchData*)&env, 256 << 4);
+            SetColorMatrix(&g_WorldEnvWork.field_2C);
+            gte_lddqa(g_WorldEnvWork.field_4C);
+            gte_lddqb_0();
+            break;
+
+        case 2:
+            func_8005A838((s_GteScratchData*)&env, 256 << 4);
+            SetColorMatrix(&g_WorldEnvWork.field_2C);
+            gte_lddqa(g_WorldEnvWork.field_4C);
+            gte_lddqb_0();
+            break;
+    }
+    lit = g_WorldEnvWork.field_0;
+
+    farcap = 0x79C << (arg2 + 2);
+    if (g_WorldEnvWork.isFogEnabled)
+    {
+        farcap = MIN(farcap, COSTUME_FOG_FAR_DIST());
+    }
+    if (Pc_WholeMapDrawActive())
+    {
+        farcap = 0x7FFFFFFF;
+    }
+
+    Costume_Transform(&rootView, n);
+    if (lit)
+    {
+        Costume_Shade(&env, n);
+    }
+    for (i = 0; i < drawnCount; i++)
+    {
+        if (Costume_Emit(drawn[i], bases[i], &env, otTag, arg2, lit, farcap, pktEnd))
+        {
+            if (!s_exhaustWarned)
+            {
+                SH_DBG("[COSTUME] packet arena exhausted; part of a costume dropped this frame");
+                s_exhaustWarned = 1;
+            }
+            break;
+        }
+    }
+}
+
+/* One prop: pose its verts at the placement, light them like a costume piece,
+ * and turn its glow verts (ring != 0: a jack-o'-lantern's face and insides)
+ * into a flickering candle colour that ignores the scene's lights. */
+static void Costume_DrawProp(const s_CostumePlace* pl, GsOT_TAG* otTag, s32 arg2, float clock, u8* pktEnd)
+{
+    static int            s_exhaustWarned = 0;
+    const s_CostumePiece* p = &s_costume.pieces[pl->piece];
+    GsCOORDINATE2         coord;
+    MATRIX                world, view;
+    s_GteScratchData2     env;
+    s32                   c   = Math_Cos(pl->yaw);
+    s32                   s   = Math_Sin(pl->yaw);
+    s32                   lit = g_WorldEnvWork.field_0;
+    s32                   farcap;
+    s32                   glow;
+    float                 fl;
+    u32                   j;
+
+    /* Rotate local +Z to (sin, 0, cos); world units are Q8 (1/256 m). */
+    memset(&coord, 0, sizeof(coord));
+    coord.coord.m[0][0] = c;
+    coord.coord.m[0][2] = s;
+    coord.coord.m[1][1] = 4096;
+    coord.coord.m[2][0] = -s;
+    coord.coord.m[2][2] = c;
+    coord.coord.t[0]    = Q12_TO_Q8(pl->x);
+    coord.coord.t[1]    = Q12_TO_Q8(pl->y);
+    coord.coord.t[2]    = Q12_TO_Q8(pl->z);
+    coord.super         = NULL;
+    Vw_CoordToWorldAndViewMatrices(&coord, &world, &view);
+
+    for (j = 0; j < p->vertCount; j++)
+    {
+        const s_CostumeVert* v = &p->verts[j];
+
+        s_costume.sv[j].vx = Costume_S16(v->pos[0]);
+        s_costume.sv[j].vy = Costume_S16(v->pos[1]);
+        s_costume.sv[j].vz = Costume_S16(v->pos[2]);
+        s_costume.sn[j].vx = Costume_S16(v->nrm[0] * 4064.0f);
+        s_costume.sn[j].vy = Costume_S16(v->nrm[1] * 4064.0f);
+        s_costume.sn[j].vz = Costume_S16(v->nrm[2] * 4064.0f);
+    }
+
+    if (lit != 0)
+    {
+        func_80057228(&world, g_WorldEnvWork.field_54, &g_WorldEnvWork.field_58, &g_WorldEnvWork.field_60);
+    }
+    g_WorldEnvWork.field_14C = 0;
+    switch (lit)
+    {
+        case 0:
+            func_8005A42C((s_GteScratchData*)&env, 256 << 4);
+            break;
+
+        case 1:
+            func_8005A478((s_GteScratchData*)&env, 256 << 4);
+            SetColorMatrix(&g_WorldEnvWork.field_2C);
+            gte_lddqa(g_WorldEnvWork.field_4C);
+            gte_lddqb_0();
+            break;
+
+        case 2:
+            func_8005A838((s_GteScratchData*)&env, 256 << 4);
+            SetColorMatrix(&g_WorldEnvWork.field_2C);
+            gte_lddqa(g_WorldEnvWork.field_4C);
+            gte_lddqb_0();
+            break;
+    }
+
+    farcap = 0x79C << (arg2 + 2);
+    if (g_WorldEnvWork.isFogEnabled)
+    {
+        farcap = MIN(farcap, COSTUME_FOG_FAR_DIST());
+    }
+
+    Costume_Transform(&view, p->vertCount);
+    if (lit)
+    {
+        Costume_Shade(&env, p->vertCount);
+    }
+    else
+    {
+        for (j = 0; j < p->vertCount; j++)
+        {
+            s_costume.shade[j] = *(s32*)&env.field_3D8;
+        }
+    }
+
+    /* Candle flicker, out of step between props. */
+    fl   = 0.85f + 0.10f * sinf(clock * 9.1f + (float)(pl->x >> 10)) + 0.05f * sinf(clock * 23.7f + (float)(pl->z >> 10));
+    glow = (s32)(0xB0 * fl) | ((s32)(0x80 * fl) << 8) | ((s32)(0x48 * fl) << 16);
+    for (j = 0; j < p->vertCount; j++)
+    {
+        if (p->verts[j].ring != 0)
+        {
+            s_costume.shade[j] = glow;
+        }
+    }
+
+    if (Costume_Emit(p, 0, &env, otTag, arg2, 1, farcap, pktEnd) && !s_exhaustWarned)
+    {
+        SH_DBG("[COSTUME] packet arena exhausted; a prop was dropped this frame");
+        s_exhaustWarned = 1;
+    }
+}
+
+void Pc_Costume_DrawProps(GsOT* ot, s32 arg2)
+{
+    static s32   s_lastBuf = -1;
+    static float s_clock   = 0.0f;
+    s32          map       = g_SavegamePtr->mapIdx;
+    u8*             pktEnd;
+    u32             i;
+
+    if (s_costume.state == 0)
+    {
+        s_costume.state = Costume_Load() ? 1 : -1;
+    }
+    if (g_ActiveBufferIdx != s_lastBuf)
+    {
+        s_lastBuf = g_ActiveBufferIdx;
+        s_clock += (float)g_DeltaTime * (1.0f / 4096.0f);
+
+#ifdef COSTUME_MARKS
+        /* Mark spot: log on the press, and drop a jack-o'-lantern facing back
+         * the way Harry looks. */
+        if (g_GameWork.gameState == GameState_InGame && g_SysWork.sysState == SysState_Gameplay)
+        {
+            s_SubCharacter* player = &g_SysWork.playerWork.player;
+            int             held   = (g_Controller0->heldBtnFlags & COSTUME_MARK_COMBO) == COSTUME_MARK_COMBO;
+
+            if (held && !s_costume.markHeld)
+            {
+                s32 yaw = (player->rotation.vy + 2048) & 0xFFF;
+
+                SH_DBG("[MARK] map %d room %d  pos %.3f %.3f %.3f  yaw %d  raw %d %d %d", (int)map,
+                       (int)g_SavegamePtr->mapRoomIdx, player->position.vx / 4096.0, player->position.vy / 4096.0,
+                       player->position.vz / 4096.0, (int)yaw, (int)player->position.vx, (int)player->position.vy,
+                       (int)player->position.vz);
+                if (s_costume.markCount < COSTUME_MAX_MARKS && s_costume.markPiece >= 0)
+                {
+                    s_CostumePlace* m = &s_costume.marks[s_costume.markCount++];
+
+                    m->map   = map;
+                    m->piece = (u32)s_costume.markPiece;
+                    m->yaw   = yaw;
+                    m->x     = player->position.vx;
+                    m->y     = player->position.vy;
+                    m->z     = player->position.vz;
+                }
+            }
+            s_costume.markHeld = held;
+        }
+#endif
+    }
+
+    if (s_costume.state != 1 || (s_costume.placeCount == 0 && s_costume.markCount == 0) || !Costume_TextureReady())
+    {
+        return;
+    }
+    pktEnd = (u8*)Pc_PacketBuf_End();
+    if (pktEnd == NULL)
+    {
+        return;
+    }
+    for (i = 0; i < s_costume.placeCount; i++)
+    {
+        s_CostumePlace* pl = &s_costume.places[i];
+
+        if (pl->map != map)
+        {
+            continue;
+        }
+        Costume_DrawProp(pl, &ot->org[2], arg2, s_clock, pktEnd);
+    }
+    for (i = 0; i < s_costume.markCount; i++)
+    {
+        if (s_costume.marks[i].map == map)
+        {
+            Costume_DrawProp(&s_costume.marks[i], &ot->org[2], arg2, s_clock, pktEnd);
+        }
+    }
+}
